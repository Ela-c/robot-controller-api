{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft.AspNetCore.Mvc": "Warning",
				"Microsoft.AspNetCore.Routing": "Warning",
				"Microsoft.AspNetCore.Hosting": "Warning"
			}
		},
		"WriteTo": [
			{
				"Name": "Console"
			}
		]
	},
	"AllowedHosts": "*",
	"RobotExecution": {
		"StepDelayMs": 300
	}
}
