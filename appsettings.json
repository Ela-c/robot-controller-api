{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft.AspNetCore.Mvc": "Warning",
				"Microsoft.AspNetCore.Routing": "Warning",
				"Microsoft.AspNetCore.Hosting": "Warning"
			}
		},
		"WriteTo": [
			{
				"Name": "Console"
			}
		]
	},
	"AllowedHosts": "*",
	"RobotExecution": {
		"MinPendingDelayMs": 900,
		"MaxPendingDelayMs": 2600,
		"MinQueuedDelayMs": 900,
		"MaxQueuedDelayMs": 2600,
		"MinStepDelayMs": 900,
		"MaxStepDelayMs": 2200,
		"SequenceFailureProbability": 0.01
	}
}
